{
  "entities": {
    "Vehicle": {
      "title": "Vehicle",
      "description": "Warehouse yard vehicle tracking record",
      "type": "object",
      "properties": {
        "id": { "type": "number" },
        "depoId": { "type": "number" },
        "cekiciPlaka": { "type": "string", "maxLength": 40 },
        "dorsePlaka": { "type": "string", "minLength": 1, "maxLength": 40 },
        "konteynirNo": { "type": "string", "maxLength": 60 },
        "soforAd": { "type": "string", "maxLength": 120 },
        "soforTel": { "type": "string", "maxLength": 40 },
        "soforTc": { "type": "string", "maxLength": 20 },
        "nakliyeFirmasi": { "type": "string", "maxLength": 150 },
        "musteri": { "type": "string", "maxLength": 200 },
        "depoTuru": { "type": "string", "enum": ["Antrepo", "Serbest Depo"] },
        "islemTuru": { "type": "string", "enum": ["Boşaltma", "Yükleme", "Tahliye"] },
        "aciklama": { "type": "string", "maxLength": 2000 },
        "fotograflar": { "type": "array", "description": "Up to 5 compressed image data URLs" },
        "isAcik": { "type": "boolean" },
        "durum": { "type": "string", "enum": ["BEKLEMEDE", "EVRAK HAZIR", "RAMPADA", "ÇIKIŞ YAPTI"] },
        "rampaId": { "type": "number" },
        "isRampayaCagrildi": { "type": "boolean" },
        "cagrildigiRampaId": { "type": "number" },
        "girisTarihi": { "type": "string", "maxLength": 60 },
        "girisTarihiIso": { "type": "string", "maxLength": 30 },
        "girisTimestamp": { "type": "number" },
        "evrakHazirTimestamp": { "type": "number" },
        "evrakKayitTarihi": { "type": "string", "maxLength": 60 },
        "rampadaTimestamp": { "type": "number" },
        "rampayaGirisTarihi": { "type": "string", "maxLength": 60 },
        "rampadanCikisTarihi": { "type": "string", "maxLength": 60 },
        "rampadanCikisTimestamp": { "type": "number" },
        "cikisTarihi": { "type": "string", "maxLength": 60 },
        "cikisTimestamp": { "type": "number" },
        "guvenlikNotlari": { "type": "array", "description": "Security feedback notes list" }
      },
      "required": ["id", "depoId", "dorsePlaka", "islemTuru", "durum", "isAcik", "girisTarihi", "girisTarihiIso", "girisTimestamp"]
    },
    "Ramp": {
      "title": "Ramp",
      "description": "Warehouse loading dock ramp definition and live state",
      "type": "object",
      "properties": {
        "id": { "type": "number" },
        "depoId": { "type": "number" },
        "ad": { "type": "string", "minLength": 1, "maxLength": 80 },
        "durum": { "type": "string", "enum": ["Boş", "Dolu", "Arızalı", "Bakımda"] },
        "arizaNotu": { "type": "string", "maxLength": 300 },
        "bakimBaslangic": { "type": "string", "maxLength": 60 }
      },
      "required": ["id", "depoId", "ad", "durum"]
    },
    "ExpectedVehicle": {
      "title": "ExpectedVehicle",
      "description": "Expected incoming vehicle schedule",
      "type": "object",
      "properties": {
        "id": { "type": "number" },
        "depoId": { "type": "number" },
        "cekiciPlaka": { "type": "string", "maxLength": 40 },
        "dorsePlaka": { "type": "string", "maxLength": 40 },
        "konteynirNo": { "type": "string", "maxLength": 60 },
        "soforAd": { "type": "string", "maxLength": 120 },
        "soforTel": { "type": "string", "maxLength": 40 },
        "soforTc": { "type": "string", "maxLength": 20 },
        "aciklama": { "type": "string", "maxLength": 2000 },
        "musteri": { "type": "string", "maxLength": 200 },
        "depoTuru": { "type": "string", "maxLength": 40 },
        "islemTuru": { "type": "string", "maxLength": 40 },
        "beklenenTarih": { "type": "string", "maxLength": 60 },
        "durum": { "type": "string", "enum": ["BEKLENİYOR", "GİRİŞ YAPILDI"] },
        "kabulTarihi": { "type": "string", "maxLength": 60 }
      },
      "required": ["id", "depoId", "durum"]
    },
    "AppNotification": {
      "title": "AppNotification",
      "description": "System call and orientation notification between security and docks",
      "type": "object",
      "properties": {
        "id": { "type": "number" },
        "depoId": { "type": "number" },
        "type": { "type": "string", "maxLength": 60 },
        "vehicleId": { "type": "number" },
        "plaka": { "type": "string", "maxLength": 40 },
        "musteri": { "type": "string", "maxLength": 200 },
        "soforAd": { "type": "string", "maxLength": 120 },
        "soforTel": { "type": "string", "maxLength": 40 },
        "rampId": { "type": "number" },
        "rampName": { "type": "string", "maxLength": 80 },
        "text": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "time": { "type": "string", "minLength": 1, "maxLength": 30 },
        "status": { "type": "string", "enum": ["BEKLİYOR", "İŞLEM YAPILDI", "ONAYLANDI", "İPTAL", "OKUNDU"] },
        "securityNote": { "type": "string", "maxLength": 1000 },
        "readBy": { "type": "array", "description": "Usernames who read this notification" }
      },
      "required": ["id", "text", "time", "status"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Internal instant message between warehouse team members across channels and DMs",
      "type": "object",
      "properties": {
        "id": { "type": "number" },
        "sender": { "type": "string", "minLength": 1, "maxLength": 120 },
        "role": { "type": "string", "minLength": 1, "maxLength": 40 },
        "text": { "type": "string", "maxLength": 2000 },
        "time": { "type": "string", "minLength": 1, "maxLength": 30 },
        "channelId": { "type": "string", "maxLength": 200 },
        "recipient": { "type": "string", "maxLength": 120 },
        "replyTo": { "type": "object" },
        "mentions": { "type": "array" },
        "readBy": { "type": "array" },
        "timestamp": { "type": "number" },
        "isEdited": { "type": "boolean" },
        "editedAt": { "type": "string", "maxLength": 30 },
        "imageUrl": { "type": "string", "maxLength": 600000 },
        "entityCard": { "type": "object" },
        "reactions": { "type": "object" },
        "isPinned": { "type": "boolean" },
        "pinnedBy": { "type": "string", "maxLength": 120 }
      },
      "required": ["id", "sender", "role", "text", "time"]
    },
    "ChatPresence": {
      "title": "ChatPresence",
      "description": "Live user online presence and active channel typing indicator",
      "type": "object",
      "properties": {
        "username": { "type": "string", "minLength": 1, "maxLength": 120 },
        "role": { "type": "string", "minLength": 1, "maxLength": 40 },
        "depoId": { "type": "number" },
        "lastActiveAt": { "type": "number" },
        "isOnline": { "type": "boolean" },
        "typingInChannel": { "type": "string", "maxLength": 200 },
        "typingAt": { "type": "number" }
      },
      "required": ["username", "role", "lastActiveAt"]
    },
    "ChatGroup": {
      "title": "ChatGroup",
      "description": "Custom team messaging group with member list and admin approval state",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "description": { "type": "string", "maxLength": 200 },
        "members": { "type": "array", "description": "Usernames belonging to this group" },
        "pendingMemberRequests": { "type": "array", "description": "Pending member addition requests awaiting admin approval" },
        "createdBy": { "type": "string", "minLength": 1, "maxLength": 120 },
        "createdAt": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected", "archived"] },
        "approvedBy": { "type": "string", "maxLength": 120 },
        "approvedAt": { "type": "number" },
        "rejectedReason": { "type": "string", "maxLength": 300 }
      },
      "required": ["id", "name", "members", "createdBy", "createdAt"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Registered customer or contractor company details",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "vergiNo": { "type": "string", "maxLength": 30 },
        "yetkili": { "type": "string", "maxLength": 120 },
        "telefon": { "type": "string", "maxLength": 40 },
        "adres": { "type": "string", "maxLength": 400 },
        "notlar": { "type": "string", "maxLength": 1000 },
        "olusturmaTarihi": { "type": "string", "maxLength": 60 }
      },
      "required": ["id", "name"]
    },
    "User": {
      "title": "User",
      "description": "Application user account with role and granular permissions",
      "type": "object",
      "properties": {
        "username": { "type": "string", "minLength": 1, "maxLength": 120 },
        "password": { "type": "string", "minLength": 1, "maxLength": 200 },
        "role": { "type": "string", "enum": ["admin", "personel", "security", "guest"] },
        "depoId": { "type": "number" },
        "permissions": { "type": "object" }
      },
      "required": ["username", "password", "role", "depoId"]
    },
    "Warehouse": {
      "title": "Warehouse",
      "description": "Warehouse facility definition and active status",
      "type": "object",
      "properties": {
        "id": { "type": "number" },
        "ad": { "type": "string", "minLength": 1, "maxLength": 120 },
        "aktif": { "type": "boolean" }
      },
      "required": ["id", "ad"]
    },
    "WhatsAppSettings": {
      "title": "WhatsAppSettings",
      "description": "Shared operational WhatsApp notification preferences (non-secret)",
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "provider": { "type": "string", "enum": ["webhook", "greenapi", "ultramsg", "twilio", "sharelink"] },
        "autoShareOnVehicleAdd": { "type": "boolean" },
        "autoShareOnRampAssign": { "type": "boolean" },
        "autoShareOnRampCall": { "type": "boolean" },
        "groupName": { "type": "string", "maxLength": 120 },
        "alwaysShowPromptModal": { "type": "boolean" },
        "customTemplate": { "type": "string", "maxLength": 1500 }
      }
    },
    "WhatsAppSecrets": {
      "title": "WhatsAppSecrets",
      "description": "Admin-only isolated WhatsApp API tokens, webhook URLs, and endpoint credentials",
      "type": "object",
      "properties": {
        "groupPhoneOrId": { "type": "string", "maxLength": 120 },
        "webhookUrl": { "type": "string", "maxLength": 500 },
        "apiKey": { "type": "string", "maxLength": 300 },
        "instanceId": { "type": "string", "maxLength": 120 },
        "twilioAccountSid": { "type": "string", "maxLength": 120 },
        "twilioAuthToken": { "type": "string", "maxLength": 200 },
        "twilioFromNumber": { "type": "string", "maxLength": 60 }
      }
    },
    "SlaSettings": {
      "title": "SlaSettings",
      "description": "Configurable SLA target durations and warning thresholds per process type",
      "type": "object",
      "properties": {
        "bosaltmaMinutes": { "type": "number" },
        "yuklemeMinutes": { "type": "number" },
        "tahliyeMinutes": { "type": "number" },
        "warningThresholdPercent": { "type": "number" }
      }
    },
    "ChatQuickMessagesSettings": {
      "title": "ChatQuickMessagesSettings",
      "description": "Admin-editable quick template messages for internal team chat",
      "type": "object",
      "properties": {
        "messages": { "type": "array", "description": "List of quick message templates" },
        "updatedBy": { "type": "string", "maxLength": 120 },
        "updatedAt": { "type": "number" }
      },
      "required": ["messages"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable system audit log recording actor, action, target, and field-level before/after diffs",
      "type": "object",
      "properties": {
        "id": { "type": "number" },
        "timestamp": { "type": "number" },
        "dateStr": { "type": "string", "minLength": 1, "maxLength": 40 },
        "isoDate": { "type": "string", "minLength": 1, "maxLength": 20 },
        "actorUsername": { "type": "string", "minLength": 1, "maxLength": 120 },
        "actorRole": { "type": "string", "enum": ["admin", "personel", "security", "guest", "system"] },
        "category": { "type": "string", "enum": ["vehicle", "ramp", "expected", "security", "auth", "user", "warehouse", "customer", "settings", "chat", "export", "audit"] },
        "action": { "type": "string", "minLength": 1, "maxLength": 80 },
        "severity": { "type": "string", "enum": ["info", "warning", "critical"] },
        "targetType": { "type": "string", "maxLength": 60 },
        "targetId": { "type": "string", "maxLength": 120 },
        "targetLabel": { "type": "string", "maxLength": 200 },
        "depoId": { "type": "number" },
        "depoName": { "type": "string", "maxLength": 120 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "changes": { "type": "array", "description": "Up to 30 before/after field change entries" },
        "metadata": { "type": "object", "description": "Optional flat string context map" }
      },
      "required": ["id", "timestamp", "dateStr", "isoDate", "actorUsername", "actorRole", "category", "action", "severity", "summary"]
    }
  },
  "firestore": {
    "/vehicles/{vehicleId}": {
      "schema": { "$ref": "#/entities/Vehicle" },
      "description": "Active and historical yard vehicles"
    },
    "/ramps/{rampId}": {
      "schema": { "$ref": "#/entities/Ramp" },
      "description": "Dock ramps and current status"
    },
    "/expectedVehicles/{expectedVehicleId}": {
      "schema": { "$ref": "#/entities/ExpectedVehicle" },
      "description": "Expected incoming vehicle schedule"
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/AppNotification" },
      "description": "Ramp call notifications and security events"
    },
    "/chatMessages/{chatMessageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Live warehouse team field chat messages"
    },
    "/chatPresence/{presenceId}": {
      "schema": { "$ref": "#/entities/ChatPresence" },
      "description": "Live chat user online status and typing presence"
    },
    "/chatGroups/{groupId}": {
      "schema": { "$ref": "#/entities/ChatGroup" },
      "description": "Custom messaging groups and member assignments"
    },
    "/customers/{customerId}": {
      "schema": { "$ref": "#/entities/Customer" },
      "description": "Registered customer and contractor companies"
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Application user accounts and permissions"
    },
    "/warehouses/{warehouseId}": {
      "schema": { "$ref": "#/entities/Warehouse" },
      "description": "Warehouse facilities and active visibility state"
    },
    "/settings/whatsapp": {
      "schema": { "$ref": "#/entities/WhatsAppSettings" },
      "description": "Shared operational WhatsApp integration preferences"
    },
    "/settings/whatsappSecrets": {
      "schema": { "$ref": "#/entities/WhatsAppSecrets" },
      "description": "Isolated WhatsApp API keys, tokens, and webhook endpoints"
    },
    "/settings/sla": {
      "schema": { "$ref": "#/entities/SlaSettings" },
      "description": "Shared SLA target duration settings"
    },
    "/settings/chatQuickMessages": {
      "schema": { "$ref": "#/entities/ChatQuickMessagesSettings" },
      "description": "Admin-editable quick chat message templates"
    },
    "/auditLogs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Immutable admin-controlled audit trail for all system actions and sessions"
    }
  }
}
