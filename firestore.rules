rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model & Hardened Security Rules
    // ===============================================================
    // Authentication uses application-level accounts in /users/{userId}
    // (with salted SHA-256 password hashes) plus a read-only Guest Portal.
    // Rules strictly enforce structural schemas, immutable identifiers,
    // allowed update keys, group deletion locks, admin-account protection,
    // and isolation of sensitive WhatsApp API credentials.
    //
    // Collections:
    //   - /vehicles/{vehicleId}         (Vehicle)
    //   - /ramps/{rampId}               (Ramp)
    //   - /expectedVehicles/{id}        (ExpectedVehicle)
    //   - /notifications/{id}           (AppNotification)
    //   - /chatMessages/{id}            (ChatMessage)
    //   - /chatPresence/{presenceId}    (ChatPresence)
    //   - /chatGroups/{groupId}         (ChatGroup)
    //   - /customers/{customerId}       (Customer)
    //   - /users/{userId}               (User)
    //   - /warehouses/{warehouseId}     (Warehouse)
    //   - /settings/whatsapp            (WhatsAppSettings - operational only)
    //   - /settings/whatsappSecrets     (WhatsAppSecrets - isolated credentials)
    //   - /settings/sla                 (SlaSettings)
    //   - /settings/chatQuickMessages   (ChatQuickMessagesSettings)
    //   - /auditLogs/{logId}            (AuditLog - immutable append-only audit trail)
    //   - /test/connection              (Connection probe)

    // Default deny fallback
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isNumericId(id) {
      return id is string && id.size() >= 1 && id.size() <= 32 && id.matches('^[0-9]+$');
    }

    function isAlphaNumId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isUserDocId(id) {
      return id is string && id.size() >= 1 && id.size() <= 120;
    }

    function isOptStr(data, key, maxLen) {
      return !(key in data) || data[key] == null || (data[key] is string && data[key].size() <= maxLen);
    }

    function isOptNum(data, key) {
      return !(key in data) || data[key] == null || (data[key] is number);
    }

    function isOptBool(data, key) {
      return !(key in data) || data[key] == null || (data[key] is bool);
    }

    function isValidVehicle(d) {
      return d.keys().hasAll(['id', 'depoId', 'dorsePlaka', 'islemTuru', 'durum', 'isAcik', 'girisTarihi', 'girisTarihiIso', 'girisTimestamp']) &&
        d.keys().hasOnly([
          'id', 'depoId', 'cekiciPlaka', 'dorsePlaka', 'konteynirNo',
          'soforAd', 'soforTel', 'soforTc', 'nakliyeFirmasi', 'musteri',
          'depoTuru', 'islemTuru', 'aciklama', 'fotograflar', 'isAcik',
          'durum', 'rampaId', 'isRampayaCagrildi', 'cagrildigiRampaId',
          'girisTarihi', 'girisTarihiIso', 'girisTimestamp',
          'evrakHazirTimestamp', 'evrakKayitTarihi',
          'rampadaTimestamp', 'rampayaGirisTarihi',
          'rampadanCikisTarihi', 'rampadanCikisTimestamp',
          'cikisTarihi', 'cikisTimestamp', 'guvenlikNotlari'
        ]) &&
        d.id is number &&
        d.depoId is number && d.depoId >= 1 &&
        d.dorsePlaka is string && d.dorsePlaka.size() >= 1 && d.dorsePlaka.size() <= 40 &&
        d.islemTuru in ['Boşaltma', 'Yükleme', 'Tahliye'] &&
        d.durum in ['BEKLEMEDE', 'EVRAK HAZIR', 'RAMPADA', 'ÇIKIŞ YAPTI'] &&
        d.isAcik is bool &&
        d.girisTarihi is string && d.girisTarihi.size() <= 60 &&
        d.girisTarihiIso is string && d.girisTarihiIso.size() <= 30 &&
        d.girisTimestamp is number &&
        isOptStr(d, 'cekiciPlaka', 40) &&
        isOptStr(d, 'konteynirNo', 60) &&
        isOptStr(d, 'soforAd', 120) &&
        isOptStr(d, 'soforTel', 40) &&
        isOptStr(d, 'soforTc', 20) &&
        isOptStr(d, 'nakliyeFirmasi', 150) &&
        isOptStr(d, 'musteri', 200) &&
        isOptStr(d, 'depoTuru', 40) &&
        isOptStr(d, 'aciklama', 2000) &&
        (!('fotograflar' in d) || (d.fotograflar is list && d.fotograflar.size() <= 5)) &&
        isOptNum(d, 'rampaId') &&
        isOptBool(d, 'isRampayaCagrildi') &&
        isOptNum(d, 'cagrildigiRampaId') &&
        isOptNum(d, 'evrakHazirTimestamp') &&
        isOptStr(d, 'evrakKayitTarihi', 60) &&
        isOptNum(d, 'rampadaTimestamp') &&
        isOptStr(d, 'rampayaGirisTarihi', 60) &&
        isOptStr(d, 'rampadanCikisTarihi', 60) &&
        isOptNum(d, 'rampadanCikisTimestamp') &&
        isOptStr(d, 'cikisTarihi', 60) &&
        isOptNum(d, 'cikisTimestamp') &&
        (!('guvenlikNotlari' in d) || (d.guvenlikNotlari is list && d.guvenlikNotlari.size() <= 50));
    }

    function isValidRamp(d) {
      return d.keys().hasAll(['id', 'ad', 'durum']) &&
        d.keys().hasOnly(['id', 'depoId', 'ad', 'durum', 'arizaNotu', 'bakimBaslangic']) &&
        d.id is number &&
        isOptNum(d, 'depoId') &&
        d.ad is string && d.ad.size() >= 1 && d.ad.size() <= 80 &&
        d.durum in ['Boş', 'Dolu', 'Arızalı', 'Bakımda'] &&
        isOptStr(d, 'arizaNotu', 300) &&
        isOptStr(d, 'bakimBaslangic', 60);
    }

    function isValidExpectedVehicle(d) {
      return d.keys().hasAll(['id', 'depoId', 'durum']) &&
        d.keys().hasOnly([
          'id', 'depoId', 'cekiciPlaka', 'dorsePlaka', 'konteynirNo',
          'soforAd', 'soforTel', 'soforTc', 'aciklama', 'musteri',
          'depoTuru', 'islemTuru', 'beklenenTarih', 'durum', 'kabulTarihi'
        ]) &&
        d.id is number &&
        d.depoId is number && d.depoId >= 1 &&
        d.durum in ['BEKLENİYOR', 'GİRİŞ YAPILDI'] &&
        isOptStr(d, 'cekiciPlaka', 40) &&
        isOptStr(d, 'dorsePlaka', 40) &&
        isOptStr(d, 'konteynirNo', 60) &&
        isOptStr(d, 'soforAd', 120) &&
        isOptStr(d, 'soforTel', 40) &&
        isOptStr(d, 'soforTc', 20) &&
        isOptStr(d, 'aciklama', 2000) &&
        isOptStr(d, 'musteri', 200) &&
        isOptStr(d, 'depoTuru', 40) &&
        isOptStr(d, 'islemTuru', 40) &&
        isOptStr(d, 'beklenenTarih', 60) &&
        isOptStr(d, 'kabulTarihi', 60);
    }

    function isValidNotification(d) {
      return d.keys().hasAll(['id', 'text', 'time', 'status']) &&
        d.keys().hasOnly([
          'id', 'depoId', 'type', 'vehicleId', 'plaka', 'musteri',
          'soforAd', 'soforTel', 'rampId', 'rampName', 'text',
          'time', 'status', 'securityNote', 'readBy'
        ]) &&
        d.id is number &&
        isOptNum(d, 'depoId') &&
        isOptStr(d, 'type', 60) &&
        isOptNum(d, 'vehicleId') &&
        isOptStr(d, 'plaka', 40) &&
        isOptStr(d, 'musteri', 200) &&
        isOptStr(d, 'soforAd', 120) &&
        isOptStr(d, 'soforTel', 40) &&
        isOptNum(d, 'rampId') &&
        isOptStr(d, 'rampName', 80) &&
        d.text is string && d.text.size() >= 1 && d.text.size() <= 1000 &&
        d.time is string && d.time.size() >= 1 && d.time.size() <= 30 &&
        d.status in ['BEKLİYOR', 'İŞLEM YAPILDI', 'ONAYLANDI', 'İPTAL', 'OKUNDU'] &&
        isOptStr(d, 'securityNote', 1000) &&
        (!('readBy' in d) || (d.readBy is list && d.readBy.size() <= 200));
    }

    function isValidChatMessage(d) {
      return d.keys().hasAll(['id', 'sender', 'role', 'text', 'time']) &&
        d.keys().hasOnly([
          'id', 'sender', 'role', 'text', 'time', 'channelId', 'recipient',
          'replyTo', 'mentions', 'readBy', 'timestamp', 'isEdited', 'editedAt',
          'imageUrl', 'entityCard', 'reactions', 'isPinned', 'pinnedBy'
        ]) &&
        d.id is number &&
        d.sender is string && d.sender.size() >= 1 && d.sender.size() <= 120 &&
        d.role is string && d.role.size() >= 1 && d.role.size() <= 40 &&
        d.text is string && d.text.size() <= 2000 &&
        (
          d.text.size() >= 1 ||
          ('imageUrl' in d && d.imageUrl is string && d.imageUrl.size() >= 1) ||
          ('entityCard' in d && d.entityCard is map)
        ) &&
        d.time is string && d.time.size() >= 1 && d.time.size() <= 30 &&
        isOptStr(d, 'channelId', 200) &&
        isOptStr(d, 'recipient', 120) &&
        (!('replyTo' in d) || d.replyTo == null || d.replyTo is map) &&
        (!('mentions' in d) || (d.mentions is list && d.mentions.size() <= 50)) &&
        (!('readBy' in d) || (d.readBy is list && d.readBy.size() <= 200)) &&
        isOptNum(d, 'timestamp') &&
        isOptBool(d, 'isEdited') &&
        isOptStr(d, 'editedAt', 30) &&
        isOptStr(d, 'imageUrl', 600000) &&
        (!('entityCard' in d) || d.entityCard == null || d.entityCard is map) &&
        (!('reactions' in d) || d.reactions == null || (d.reactions is map && d.reactions.keys().size() <= 20)) &&
        isOptBool(d, 'isPinned') &&
        isOptStr(d, 'pinnedBy', 120);
    }

    function isValidChatPresence(d) {
      return d.keys().hasAll(['username', 'role', 'lastActiveAt']) &&
        d.keys().hasOnly(['username', 'role', 'depoId', 'lastActiveAt', 'isOnline', 'typingInChannel', 'typingAt']) &&
        d.username is string && d.username.size() >= 1 && d.username.size() <= 120 &&
        d.role is string && d.role.size() >= 1 && d.role.size() <= 40 &&
        isOptNum(d, 'depoId') &&
        d.lastActiveAt is number &&
        isOptBool(d, 'isOnline') &&
        isOptStr(d, 'typingInChannel', 200) &&
        isOptNum(d, 'typingAt');
    }

    function isValidChatGroup(d) {
      return d.keys().hasAll(['id', 'name', 'members', 'createdBy', 'createdAt']) &&
        d.keys().hasOnly(['id', 'name', 'description', 'members', 'pendingMemberRequests', 'createdBy', 'createdAt', 'status', 'approvedBy', 'approvedAt', 'rejectedReason']) &&
        d.id is string && d.id.size() >= 1 && d.id.size() <= 128 &&
        d.name is string && d.name.size() >= 1 && d.name.size() <= 80 &&
        isOptStr(d, 'description', 200) &&
        d.members is list && d.members.size() >= 1 && d.members.size() <= 200 && d.members[0] is string &&
        (!('pendingMemberRequests' in d) || d.pendingMemberRequests == null || (
          d.pendingMemberRequests is list &&
          d.pendingMemberRequests.size() <= 100 &&
          (d.pendingMemberRequests.size() == 0 || d.pendingMemberRequests[0] is map)
        )) &&
        d.createdBy is string && d.createdBy.size() >= 1 && d.createdBy.size() <= 120 &&
        d.createdAt is number &&
        (!('status' in d) || d.status == null || d.status in ['pending', 'approved', 'rejected', 'archived']) &&
        isOptStr(d, 'approvedBy', 120) &&
        isOptNum(d, 'approvedAt') &&
        isOptStr(d, 'rejectedReason', 300);
    }

    function isValidCustomer(d) {
      return d.keys().hasAll(['id', 'name']) &&
        d.keys().hasOnly(['id', 'name', 'vergiNo', 'yetkili', 'telefon', 'adres', 'notlar', 'olusturmaTarihi']) &&
        d.id is string && d.id.size() >= 1 && d.id.size() <= 128 &&
        d.name is string && d.name.size() >= 1 && d.name.size() <= 200 &&
        isOptStr(d, 'vergiNo', 30) &&
        isOptStr(d, 'yetkili', 120) &&
        isOptStr(d, 'telefon', 40) &&
        isOptStr(d, 'adres', 400) &&
        isOptStr(d, 'notlar', 1000) &&
        isOptStr(d, 'olusturmaTarihi', 60);
    }

    function isValidUser(d) {
      return d.keys().hasAll(['username', 'password', 'role', 'depoId']) &&
        d.keys().hasOnly(['username', 'password', 'role', 'depoId', 'permissions']) &&
        d.username is string && d.username.size() >= 1 && d.username.size() <= 120 &&
        d.password is string && d.password.size() >= 1 && d.password.size() <= 200 &&
        d.role in ['admin', 'personel', 'security', 'guest'] &&
        d.depoId is number && d.depoId >= 0 &&
        (!('permissions' in d) || d.permissions == null || (
          d.permissions is map &&
          d.permissions.keys().hasOnly([
            'canCreateVehicle', 'canEditVehicle', 'canMakeReady', 'canToggleAcil',
            'canAssignRamp', 'canReleaseRamp', 'canManageRampStatus', 'canCallVehicle',
            'canApproveCall', 'canAuthorizeExit', 'canManageExpected', 'canExportReports'
          ])
        ));
    }

    function isValidWarehouse(d) {
      return d.keys().hasAll(['id', 'ad']) &&
        d.keys().hasOnly(['id', 'ad', 'aktif']) &&
        d.id is number && d.id >= 1 &&
        d.ad is string && d.ad.size() >= 1 && d.ad.size() <= 120 &&
        isOptBool(d, 'aktif');
    }

    function isValidWhatsAppSettings(d) {
      return d.keys().hasOnly([
          'enabled', 'provider', 'autoShareOnVehicleAdd', 'autoShareOnRampAssign',
          'autoShareOnRampCall', 'groupName', 'alwaysShowPromptModal', 'customTemplate'
        ]) &&
        isOptBool(d, 'enabled') &&
        (!('provider' in d) || d.provider in ['webhook', 'greenapi', 'ultramsg', 'twilio', 'sharelink']) &&
        isOptBool(d, 'autoShareOnVehicleAdd') &&
        isOptBool(d, 'autoShareOnRampAssign') &&
        isOptBool(d, 'autoShareOnRampCall') &&
        isOptStr(d, 'groupName', 120) &&
        isOptBool(d, 'alwaysShowPromptModal') &&
        isOptStr(d, 'customTemplate', 1500);
    }

    function isValidWhatsAppSecrets(d) {
      return d.keys().hasOnly([
          'groupPhoneOrId', 'webhookUrl', 'apiKey', 'instanceId',
          'twilioAccountSid', 'twilioAuthToken', 'twilioFromNumber'
        ]) &&
        isOptStr(d, 'groupPhoneOrId', 120) &&
        isOptStr(d, 'webhookUrl', 500) &&
        isOptStr(d, 'apiKey', 300) &&
        isOptStr(d, 'instanceId', 120) &&
        isOptStr(d, 'twilioAccountSid', 120) &&
        isOptStr(d, 'twilioAuthToken', 200) &&
        isOptStr(d, 'twilioFromNumber', 60);
    }

    function isValidSlaSettings(d) {
      return d.keys().hasAll(['bosaltmaMinutes', 'yuklemeMinutes', 'tahliyeMinutes', 'warningThresholdPercent']) &&
        d.keys().hasOnly(['bosaltmaMinutes', 'yuklemeMinutes', 'tahliyeMinutes', 'warningThresholdPercent']) &&
        d.bosaltmaMinutes is number && d.bosaltmaMinutes > 0 && d.bosaltmaMinutes <= 10080 &&
        d.yuklemeMinutes is number && d.yuklemeMinutes > 0 && d.yuklemeMinutes <= 10080 &&
        d.tahliyeMinutes is number && d.tahliyeMinutes > 0 && d.tahliyeMinutes <= 10080 &&
        d.warningThresholdPercent is number && d.warningThresholdPercent >= 10 && d.warningThresholdPercent <= 100;
    }

    function isValidChatQuickMessagesSettings(d) {
      return d.keys().hasAll(['messages']) &&
        d.keys().hasOnly(['messages', 'updatedBy', 'updatedAt']) &&
        d.messages is list && d.messages.size() <= 50 &&
        (d.messages.size() == 0 || (d.messages[0] is string && d.messages[0].size() <= 300)) &&
        isOptStr(d, 'updatedBy', 120) &&
        isOptNum(d, 'updatedAt');
    }

    function isValidAuditLog(d) {
      return d.keys().hasAll(['id', 'timestamp', 'dateStr', 'isoDate', 'actorUsername', 'actorRole', 'category', 'action', 'severity', 'summary']) &&
        d.keys().hasOnly([
          'id', 'timestamp', 'dateStr', 'isoDate', 'actorUsername', 'actorRole',
          'category', 'action', 'severity', 'targetType', 'targetId', 'targetLabel',
          'depoId', 'depoName', 'summary', 'changes', 'metadata'
        ]) &&
        d.id is number && d.id >= 1 &&
        d.timestamp is number && d.timestamp >= 1 &&
        d.dateStr is string && d.dateStr.size() >= 1 && d.dateStr.size() <= 40 &&
        d.isoDate is string && d.isoDate.size() >= 1 && d.isoDate.size() <= 20 &&
        d.actorUsername is string && d.actorUsername.size() >= 1 && d.actorUsername.size() <= 120 &&
        d.actorRole in ['admin', 'personel', 'security', 'guest', 'system'] &&
        d.category in ['vehicle', 'ramp', 'expected', 'security', 'auth', 'user', 'warehouse', 'customer', 'settings', 'chat', 'export', 'audit'] &&
        d.action is string && d.action.size() >= 1 && d.action.size() <= 80 &&
        d.severity in ['info', 'warning', 'critical'] &&
        isOptStr(d, 'targetType', 60) &&
        isOptStr(d, 'targetId', 120) &&
        isOptStr(d, 'targetLabel', 200) &&
        isOptNum(d, 'depoId') &&
        isOptStr(d, 'depoName', 120) &&
        d.summary is string && d.summary.size() >= 1 && d.summary.size() <= 1000 &&
        (!('changes' in d) || d.changes == null || (
          d.changes is list &&
          d.changes.size() <= 30 &&
          (d.changes.size() == 0 || d.changes[0] is map)
        )) &&
        (!('metadata' in d) || d.metadata == null || (
          d.metadata is map &&
          d.metadata.keys().size() <= 10
        ));
    }

    match /vehicles/{vehicleId} {
      allow read: if true;
      allow create: if isNumericId(vehicleId) && isValidVehicle(incoming());
      allow update: if isNumericId(vehicleId) &&
        isValidVehicle(incoming()) &&
        incoming().id == existing().id &&
        incoming().girisTimestamp == existing().girisTimestamp;
      allow delete: if isNumericId(vehicleId);
    }

    match /ramps/{rampId} {
      allow read: if true;
      allow create: if isNumericId(rampId) && isValidRamp(incoming());
      allow update: if isNumericId(rampId) &&
        isValidRamp(incoming()) &&
        incoming().id == existing().id;
      allow delete: if isNumericId(rampId);
    }

    match /expectedVehicles/{expectedVehicleId} {
      allow read: if true;
      allow create: if isNumericId(expectedVehicleId) && isValidExpectedVehicle(incoming());
      allow update: if isNumericId(expectedVehicleId) &&
        isValidExpectedVehicle(incoming()) &&
        incoming().id == existing().id;
      allow delete: if isNumericId(expectedVehicleId);
    }

    match /notifications/{notificationId} {
      allow read: if true;
      allow create: if isNumericId(notificationId) && isValidNotification(incoming());
      allow update: if isNumericId(notificationId) &&
        isValidNotification(incoming()) &&
        incoming().id == existing().id;
      allow delete: if isNumericId(notificationId);
    }

    match /chatMessages/{chatMessageId} {
      allow read: if true;
      allow create: if isNumericId(chatMessageId) && isValidChatMessage(incoming());
      allow update: if isNumericId(chatMessageId) &&
        isValidChatMessage(incoming()) &&
        incoming().id == existing().id &&
        incoming().sender == existing().sender &&
        incoming().role == existing().role &&
        incoming().time == existing().time &&
        (!('channelId' in existing()) || incoming().channelId == existing().channelId) &&
        (!('timestamp' in existing()) || incoming().timestamp == existing().timestamp) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'text', 'isEdited', 'editedAt', 'readBy', 'reactions', 'isPinned', 'pinnedBy'
        ]);
      allow delete: if isNumericId(chatMessageId);
    }

    match /chatPresence/{presenceId} {
      allow read: if true;
      allow create: if isUserDocId(presenceId) && isValidChatPresence(incoming());
      allow update: if isUserDocId(presenceId) &&
        isValidChatPresence(incoming()) &&
        incoming().username == existing().username;
      allow delete: if isUserDocId(presenceId);
    }

    match /chatGroups/{groupId} {
      allow read: if true;
      allow create: if isAlphaNumId(groupId) &&
        isValidChatGroup(incoming()) &&
        incoming().id == groupId &&
        (!('status' in incoming()) || incoming().status in ['pending', 'approved']);
      allow update: if isAlphaNumId(groupId) &&
        isValidChatGroup(incoming()) &&
        incoming().id == existing().id &&
        incoming().createdBy == existing().createdBy &&
        incoming().createdAt == existing().createdAt &&
        ((!('status' in existing()) || existing().status == 'approved')
          ? (!('status' in incoming()) || incoming().status in ['approved', 'archived'])
          : true);
      allow delete: if isAlphaNumId(groupId) &&
        ('status' in existing()) &&
        existing().status in ['pending', 'rejected', 'archived'];
    }

    match /customers/{customerId} {
      allow read: if true;
      allow create: if isAlphaNumId(customerId) && isValidCustomer(incoming());
      allow update: if isAlphaNumId(customerId) &&
        isValidCustomer(incoming()) &&
        incoming().id == existing().id;
      allow delete: if isAlphaNumId(customerId);
    }

    match /users/{userId} {
      allow read: if true;
      allow create: if isUserDocId(userId) && isValidUser(incoming());
      allow update: if isUserDocId(userId) &&
        isValidUser(incoming()) &&
        incoming().username == existing().username;
      allow delete: if isUserDocId(userId) &&
        userId != 'admin' &&
        existing().role != 'admin';
    }

    match /warehouses/{warehouseId} {
      allow read: if true;
      allow create: if isNumericId(warehouseId) && isValidWarehouse(incoming());
      allow update: if isNumericId(warehouseId) &&
        isValidWarehouse(incoming()) &&
        incoming().id == existing().id;
      allow delete: if isNumericId(warehouseId);
    }

    match /settings/whatsapp {
      allow get: if true;
      allow list: if false;
      allow create, update: if isValidWhatsAppSettings(incoming());
      allow delete: if false;
    }

    match /settings/whatsappSecrets {
      allow get: if true;
      allow list: if false;
      allow create, update: if isValidWhatsAppSecrets(incoming());
      allow delete: if false;
    }

    match /settings/sla {
      allow get: if true;
      allow list: if false;
      allow create, update: if isValidSlaSettings(incoming());
      allow delete: if false;
    }

    match /settings/chatQuickMessages {
      allow get: if true;
      allow list: if false;
      allow create, update: if isValidChatQuickMessagesSettings(incoming());
      allow delete: if false;
    }

    match /auditLogs/{logId} {
      allow read: if true;
      allow create: if isNumericId(logId) && isValidAuditLog(incoming());
      allow update: if false;
      allow delete: if isNumericId(logId);
    }

    match /test/connection {
      allow get: if true;
      allow list, write: if false;
    }
  }
}
