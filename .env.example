# =================================================================
# Ortam Değişkenleri (Environment Variables) - Vercel & Production
# =================================================================
# Bu dosya Vercel veya başka bir platforma deploy ederken kullanabileceğiniz
# ortam değişkenleri şablonudur.
# 
# NOT: Eğer projenizde firebase-applet-config.json dosyası mevcutsa bu değişkenleri
# tanımlamadan da çalışır. Ancak Vercel kontrol panelinde (Project Settings > Environment Variables)
# tanımlamak güvenlik ve esneklik açısından en iyi uygulamadır.

# Firebase Web Yapılandırması (Vercel için VITE_ ön eki zorunludur)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_DATABASE_ID=""

# Gemini AI (Opsiyonel)
GEMINI_API_KEY=""
APP_URL=""
